# 10.5../16 is a completely open network. Typically I have all dhcp leases added to my ott.cbains.ca zone automagically, and that dns server serves all vlans.
# This leaks (a bit of) information to everyone within radio range, assuming they know, or can guess the hostnames of machines on my network, since they can poke at my network topology and figure out which devices are in what network segments.
# Instead, on this network we continnue to use the nice DNS setup (dhcp registration + dns crypt + monitoring), but we drop any requests that could otherwise reveal network topology.

# I use nat to send all DNS traffic to the network wide resolver, hence the "any" dest.
drop dns 10.5.0.0/16 any -> any any (msg:"DNS Query for local zone"; dns.query; dotprefix; content:".ott.cbains.ca"; nocase; endswith; metadata:created_at 2024_12_25, updated_at 2024_12_25; classtype:misc-activity; sid:999991; rev:6;)

# --- LG webOS TV (10.4.255.249, media vlan): YouTube-only egress ---
# The TV phones home constantly (LG ads/telemetry/ThinQ/recs). The only routed (non-L2) egress I
# want from it is YouTube. Match on TLS SNI / HTTP host, NOT on IP: YouTube and the telemetry
# endpoints share the same Google IP ranges, so only the hostname can tell them apart.
# Dest is "!10.4.0.0/16" so intra-segment L2 and DNS-to-resolver are untouched.
# QUIC (udp/443) is blocked by a pf rule on LAN_MEDIA, which forces TCP TLS so SNI is visible.
#
# GOTCHA (Suricata 8.0.7): a NEGATED pcre on a sticky buffer (pcre:"!/.../") is effectively
# inverted -- it dropped www.youtube.com and passed everything else. Use a positive pcre with a
# negative lookahead instead: /^(?!<allowed>$)/ matches (=> drop) only names NOT on the allowlist.
#
# Allowlist beyond YouTube proper: the YouTube app first runs webOS's network check against
# connectivitycheck.gstatic.com / www.gstatic.com / clients3|4.google.com (plain HTTP
# generate_204); if that fails the app reports "not connected". accounts.google.com and
# oauth2.googleapis.com are for account sign-in/linking.
drop tls 10.4.255.249 any -> !10.4.0.0/16 any (flow:to_server,established; tls.sni; pcre:"/^(?!(?:.*\.)?(?:youtube\.com|youtube-nocookie\.com|ytimg\.com|ggpht\.com|googlevideo\.com|(?:youtubei|jnn-pa|play|oauth2)\.googleapis\.com|connectivitycheck\.gstatic\.com|www\.gstatic\.com|clients[34]\.google\.com|accounts\.google\.com)$)/i"; msg:"MEDIA-TV: non-YouTube TLS blocked"; metadata:created_at 2026_10_25, updated_at 2026_10_31; classtype:policy-violation; sid:999992; rev:2;)
drop http 10.4.255.249 any -> !10.4.0.0/16 any (flow:to_server,established; http.host; pcre:"/^(?!(?:.*\.)?(?:youtube\.com|ytimg\.com|googlevideo\.com|googleapis\.com|connectivitycheck\.gstatic\.com|www\.gstatic\.com|clients[34]\.google\.com)$)/i"; msg:"MEDIA-TV: non-YouTube HTTP blocked"; metadata:created_at 2026_10_25, updated_at 2026_10_31; classtype:policy-violation; sid:999993; rev:2;)
